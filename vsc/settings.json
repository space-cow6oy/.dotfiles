    // ln -s ~/.dotfiles/vsc/settings.json ~/.config/VSCodium/User/
{
    "files.watcherExclude": {
        "**/.bloop": true,
        "**/.metals": true
    },
    "editor.lineHeight": 1.5,
    "editor.cursorSurroundingLines": 4,
    "python.useEnvironmentsExtension": true,
    "editor.fontSize": 16,
    "markdown.preview.fontSize": 16,
    "workbench.statusBar.experimental.fontSize": 8,
    "workbench.experimental.fontSize": 14,
    "workbench.sideBar.experimental.fontSize": 12.5,
    "workbench.tabs.experimental.fontSize": 10,
    "terminal.integrated.fontSize": 14,
    "debug.console.fontSize": 14,
    "workbench.activityBar.experimental.fontSize": 14,
    "window.zoomLevel": 3.5,
    "workbench.activityBar.location": "hidden",
    "window.menuBarVisibility": "compact",
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "extensions.ignoreRecommendations": true,
    "breadcrumbs.enabled": false,
    "editor.scrollbar.verticalScrollbarSize": 0,
    "workbench.sideBar.location": "left",
    "editor.minimap.enabled": false,
    "workbench.editor.wrapTabs": true,
    "editor.rulers": [
        80,
    ],
    "window.density.editorTabHeight": "compact",
    "editor.fontLigatures": true,
    "zenMode.centerLayout": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.hideStatusBar": false,
    "workbench.startupEditor": "none",
    "zenMode.restore": true,
    "diffEditor.ignoreTrimWhitespace": true,
    "editor.inlineSuggest.edits.showCollapsed": true,
    "editor.stickyScroll.enabled": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "editor.fontFamily": "'JetBrains Mono', 'monospace', monospace",
    // VIM
    "vim.leader": "<Space>",
    "vim.hlsearch": true,
    "vim.useSystemClipboard": true,
    "vim.highlightedyank.enable": true,
    "vim.highlightedyank.color": "rgba(250, 240, 170, 0.5)",
    "vim.highlightedyank.textColor": "white",
    "vim.visualModeKeyBindings": [
        {
            "before": [
                "leader",
                "k"
            ],
            "commands": [
                ":bprevious"
            ]
        },
        {
            "before": [
                "leader",
                "j"
            ],
            "commands": [
                ":bnext"
            ]
        },
        {
            "before": [
                "J"
            ],
            "after": [
                "<c-d>"
            ]
        },
        {
            "before": [
                "K"
            ],
            "after": [
                "<c-u>"
            ]
        },
        {
            "before": [
                "H"
            ],
            "after": [
                "^"
            ]
        },
        {
            "before": [
                "L"
            ],
            "after": [
                "$"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "leader",
                "w"
            ],
            "commands": [
                ":w!"
            ]
        },
        {
            "before": [
                "leader",
                "q"
            ],
            "commands": [
                ":q!"
            ]
        },
        {
            "before": [
                "leader",
                "q"
            ],
            "commands": [
                ":q!"
            ]
        },
        {
            "before": [
                "J"
            ],
            "after": [
                "<c-d>"
            ]
        },
        {
            "before": [
                "K"
            ],
            "after": [
                "<c-u>"
            ]
        },
        {
            "before": [
                "H"
            ],
            "after": [
                "^"
            ]
        },
        {
            "before": [
                "L"
            ],
            "after": [
                "$"
            ]
        }
    ],
    "vim.normalModeKeyBindings": [
        {
            "before": [
                " ",
                ":"
            ],
            "commands": [
                "workbench.action.showCommands"
            ]
        },
        {
            "before": [
                " ",
                "b"
            ],
            "commands": [
                "workbench.action.showAllEditorsByMostRecentlyUsed"
            ]
        },
        {
            "before": [
                " ",
                "t"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [
                " ",
                "h"
            ],
            "commands": [
                "editor.action.showDefinitionPreviewHover"
            ],
            "recursive": true
        },
        {
            "before": [
                "-"
            ],
            "commands": [
                {
                    "command": "oil-code.open"
                }
            ]
        },
        {
            "before": [
                "<cr>"
            ],
            "commands": [
                {
                    "command": "oil-code.select"
                }
            ]
        },
        {
            "before": [
                "<c-l>"
            ],
            "commands": [
                {
                    "command": "oil-code.refresh"
                }
            ]
        },
        {
            "before": [
                "`"
            ],
            "commands": [
                {
                    "command": "oil-code.cd"
                }
            ]
        }
    ],
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "k",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "workbench.colorTheme": "Quiet Light",
}